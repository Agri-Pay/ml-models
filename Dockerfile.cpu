# CPU-only Dockerfile for development without GPU
FROM python:3.10-slim

WORKDIR /app

# System dependencies for rasterio/GDAL and opencv
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgdal-dev \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Install uv (fast Rust-based package manager)
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

COPY requirements.txt .
# Install CPU-only PyTorch first, then remaining deps — all via uv for parallel downloads
RUN uv pip install --system --no-cache \
    torch torchvision \
    --index-url https://download.pytorch.org/whl/cpu
RUN uv pip install --system --no-cache -r requirements.txt

COPY app/ ./app/

EXPOSE 8001

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8001"]
