# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# Local dev
IMAGERY_DIR=/data
MODEL_WEIGHTS_DIR=/app/model_weights
COMPUTE_DISPATCH_MODE=local   # "local", "hpc", or "auto"
COMPUTE_PORT=8001
MAX_LOADED_MODELS=3
JOB_RESULT_TTL_HOURS=2
MAX_IMAGE_DIMENSION=50000
MAX_UPLOAD_BYTES=10737418240  # 10 GB

# CORS — comma-separated origins (empty = use defaults)
# CORS_ORIGINS=https://agripay.netlify.app

# Cloud (Modal) - only needed when COMPUTE_DISPATCH_MODE=modal
# MODAL_TOKEN_ID=<from-modal-dashboard>
# MODAL_TOKEN_SECRET=<from-modal-dashboard>

# HPC (Rustam2) - only needed when COMPUTE_DISPATCH_MODE=hpc or auto
# HPC_SSH_HOST=203.135.63.78
# HPC_SSH_USER=your-hpc-username
# HPC_SSH_PASSWORD=your-hpc-password
