# =============================================================
# AgriPay Compute Backend — Production Environment Variables
# =============================================================
# Copy this file to .env and fill in your values:
#   cp .env.production.example .env
#   nano .env

# --- Supabase ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Storage ---
IMAGERY_DIR=/data
MODEL_WEIGHTS_DIR=/app/model_weights

# --- Compute ---
COMPUTE_DISPATCH_MODE=local
COMPUTE_PORT=8001
MAX_LOADED_MODELS=3
JOB_RESULT_TTL_HOURS=2
MAX_IMAGE_DIMENSION=50000
MAX_UPLOAD_BYTES=10737418240      # 10 GB

# --- CORS ---
# Comma-separated list of allowed origins.
# Include your Netlify URL and any Cloudflare Tunnel URLs.
# Leave empty to use defaults (localhost:5173, localhost:3000, agripay.netlify.app).
CORS_ORIGINS=https://agripay.netlify.app
